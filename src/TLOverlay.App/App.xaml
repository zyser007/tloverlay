<Application x:Class="TLOverlay.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>

    <!--
      Thai needs a font with proper mark positioning: stacked vowels and tone
      marks render as overlapping boxes in many Latin-first UI fonts. Leelawadee
      UI ships with Windows and handles this correctly, so the app has a working
      Thai face with no bundled font.
    -->
    <FontFamily x:Key="ThaiUiFont">Leelawadee UI, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>

    <!--
      A light palette, close to ordinary Windows chrome. The earlier dark one
      fought the framework: WPF's stock ComboBox, TextBox and ListBox draw
      themselves light, so a near-white foreground rendered white-on-white and
      the model dropdown looked empty. Styling with the grain costs nothing here
      and removes that whole class of bug.

      Note this applies to the app's own windows only. The overlay and the region
      editor stay dark on purpose - they are drawn over a game, not over Windows.
    -->
    <SolidColorBrush x:Key="PanelBackground" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="PanelForeground" Color="#FF16191D" />
    <SolidColorBrush x:Key="PanelMuted" Color="#FF5B6470" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF1668C7" />

    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceBorder" Color="#FFDCE0E5" />
    <SolidColorBrush x:Key="TrackBackground" Color="#FFE4E7EB" />
    <SolidColorBrush x:Key="CodeBackground" Color="#FFF6F7F9" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF107C41" />
    <!-- The update banner: present enough to notice, quiet enough to ignore. -->
    <SolidColorBrush x:Key="AccentSoftBackground" Color="#FFE8F1FC" />
    <SolidColorBrush x:Key="AccentSoftBorder" Color="#FFB6D3F2" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFA1540A" />

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource ThaiUiFont}" />
      <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource ThaiUiFont}" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="MinWidth" Value="110" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="FontFamily" Value="{StaticResource ThaiUiFont}" />
      <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="FontFamily" Value="{StaticResource ThaiUiFont}" />
      <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
    </Style>

    <Style TargetType="Expander">
      <Setter Property="FontFamily" Value="{StaticResource ThaiUiFont}" />
      <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
    </Style>

    <!--
      Icons are drawn as geometry rather than pulled from Segoe MDL2 Assets.
      A glyph font means guessing private-use codepoints that render as boxes
      when wrong, and there is no way to check that from here; a path either
      draws or it does not. All of them are stroked in a 24x24 box and scaled
      with Stretch="Uniform", so the exact coordinates matter little.
    -->
    <Geometry x:Key="IconRefresh">M 4.5,10.5 A 7.5,7.5 0 0 1 18.5,8.5 M 18.5,8.5 L 15,7.5 M 18.5,8.5 L 17.5,12 M 19.5,13.5 A 7.5,7.5 0 0 1 5.5,15.5 M 5.5,15.5 L 9,16.5 M 5.5,15.5 L 6.5,12</Geometry>
    <Geometry x:Key="IconRegion">M 3,8 V 4 H 8 M 16,4 H 21 V 8 M 21,16 V 20 H 16 M 8,20 H 3 V 16</Geometry>
    <Geometry x:Key="IconPlay">M 7,4 L 20,12 L 7,20 Z</Geometry>
    <Geometry x:Key="IconStop">M 6,6 H 18 V 18 H 6 Z</Geometry>
    <Geometry x:Key="IconModel">M 12,3 V 14 M 7.5,9.5 L 12,14 L 16.5,9.5 M 4,19 H 20</Geometry>
    <Geometry x:Key="IconText">M 5,6 H 19 M 12,6 V 19 M 9,19 H 15</Geometry>
    <Geometry x:Key="IconPointer">M 6,3 L 6,18 L 10,14 L 13,20.5 L 15.5,19.5 L 12.5,13.5 L 18,13.5 Z</Geometry>
    <Geometry x:Key="IconOnce">M 13,2 L 6,13 H 11 L 10,22 L 18,10 H 12 Z</Geometry>
    <Geometry x:Key="IconScreen">M 3,5 H 21 V 16 H 3 Z M 8,20 H 16 M 12,16 V 20 M 6,9 H 13 M 6,12 H 11</Geometry>
    <Geometry x:Key="IconSettings">M 12,9 A 3,3 0 1 0 12,15 A 3,3 0 1 0 12,9 M 12,3 L 13.2,5.6 L 16,5 L 17.5,7.4 L 15.8,9.6 A 6,6 0 0 1 15.8,14.4 L 17.5,16.6 L 16,19 L 13.2,18.4 L 12,21 L 10.8,18.4 L 8,19 L 6.5,16.6 L 8.2,14.4 A 6,6 0 0 1 8.2,9.6 L 6.5,7.4 L 8,5 L 10.8,5.6 Z</Geometry>
    <Geometry x:Key="IconDownload">M 12,3 V 15 M 7,10 L 12,15 L 17,10 M 4,20 H 20</Geometry>
    <Geometry x:Key="IconFolder">M 3,7 H 9 L 11,9.5 H 21 V 19 H 3 Z</Geometry>
    <Geometry x:Key="IconReset">M 4,10 V 4 H 10 M 4,4 L 11,11 M 11,11 H 20 V 20 H 11 Z</Geometry>

    <Style x:Key="ButtonIcon" TargetType="Path">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Stroke" Value="{StaticResource PanelForeground}" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Filled glyphs read better than outlines at this size. -->
    <Style x:Key="ButtonIconFilled" TargetType="Path" BasedOn="{StaticResource ButtonIcon}">
      <Setter Property="Fill" Value="{StaticResource PanelForeground}" />
      <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <!--
    The only Slider in the app, so it carries its own look rather than a theme:
    the stock template is a different visual language from everything else here.
    Same two brushes the update ProgressBar uses.
  -->
  <Style x:Key="ThinSlider" TargetType="Slider">
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="TickFrequency" Value="0.05" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="{StaticResource TrackBackground}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Height="4">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Height="4">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="14" Height="14" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Fill="{StaticResource AccentBrush}" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,11" />
    </Style>

    <Style x:Key="CardHeading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PanelMuted}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Keycap. Monospaced so Ctrl+Alt+T and Ctrl+Alt+G line up in a column. -->
    <Style x:Key="Keycap" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CodeBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1,1,1,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,1,7,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

  </Application.Resources>
</Application>
