<Window x:Class="TLOverlay.App.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLOverlay"
        Icon="/Assets/tloverlay.ico"
        Height="815" Width="600"
        MinHeight="400" MinWidth="580"
        Background="{StaticResource PanelBackground}"
        FontFamily="{StaticResource ThaiUiFont}">

  <!--
    Two rows: everything scrolls, the action buttons do not.

    Both halves of that matter. Thai text at 125% or 150% display scaling is
    half again as tall as it is here, and a window sized for 100% simply cut the
    buttons off the bottom - so the body scrolls rather than being clipped. And
    the one control the player came for is "เริ่มแปล", which is why it is pinned
    instead of being somewhere down the scroll.
  -->
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--
      A new version, announced where it cannot be missed and cannot interrupt.
      Above the scroll rather than inside it, because an update that scrolls out
      of sight is one nobody installs; a banner rather than a dialog, because the
      player may well be in a game.
    -->
    <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed"
            Background="{StaticResource AccentSoftBackground}"
            BorderBrush="{StaticResource AccentSoftBorder}"
            BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="UpdateDetail" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource PanelMuted}" Margin="0,4,0,0" />

        <ProgressBar x:Name="UpdateProgress" Height="6" Minimum="0" Maximum="1"
                     Visibility="Collapsed" Margin="0,10,0,0"
                     Background="{StaticResource TrackBackground}"
                     Foreground="{StaticResource AccentBrush}" BorderThickness="0" />

        <WrapPanel x:Name="UpdateActions" Margin="0,10,0,0">
          <Button x:Name="UpdateInstallButton" Click="OnUpdateInstallClick"
                  Padding="12,6" MinWidth="0" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource IconDownload}" Style="{StaticResource ButtonIcon}" />
              <TextBlock Text="อัพเดทเลย" />
            </StackPanel>
          </Button>

          <Button x:Name="UpdateNotesButton" Content="ดูรายละเอียด" Click="OnUpdateNotesClick"
                  Padding="12,6" MinWidth="0" Margin="0,0,8,0" />

          <Button x:Name="UpdateSkipButton" Content="ข้ามรุ่นนี้" Click="OnUpdateSkipClick"
                  Padding="12,6" MinWidth="0" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
      <StackPanel>

        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="เลือกหน้าต่างเกม" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="เกมต้องรันแบบ Windowed Fullscreen (Borderless) — โหมด Exclusive Fullscreen จะจับภาพไม่ได้"
                     Foreground="{StaticResource PanelMuted}"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0" />
        </StackPanel>

        <!-- A fixed height with its own scrollbar: inside a ScrollViewer a list
             that sizes to its contents would push everything else away. -->
        <ListBox x:Name="WindowList"
                 Height="150"
                 Background="{StaticResource SurfaceBackground}"
                 Foreground="{StaticResource PanelForeground}"
                 BorderBrush="{StaticResource SurfaceBorder}"
                 SelectionChanged="OnWindowSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Foreground="{StaticResource PanelMuted}" FontSize="12">
                  <Run Text="{Binding ProcessName, Mode=OneWay}" />
                  <Run Text=" — " />
                  <Run Text="{Binding Width, Mode=OneWay}" />
                  <Run Text="x" />
                  <Run Text="{Binding Height, Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            <TextBlock x:Name="MetricsText"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PanelMuted}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="12"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- Display: what is drawn over the game, and whether the mouse goes through it. -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="การแสดงผลบนจอเกม" Style="{StaticResource CardHeading}" />

            <!-- WrapPanel throughout: at large display scaling these rows are
                 wider than the window, and wrapping beats being cut off. -->
            <WrapPanel Margin="0,0,0,12">
              <ToggleButton x:Name="ShowTranslationsToggle" IsChecked="True" Padding="12,6" MinWidth="0"
                            Margin="0,0,8,6" Checked="OnLayerToggled" Unchecked="OnLayerToggled">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconText}" Style="{StaticResource ButtonIcon}" />
                  <TextBlock Text="ข้อความแปล" />
                </StackPanel>
              </ToggleButton>

              <ToggleButton x:Name="ShowRegionToggle" Padding="12,6" MinWidth="0" Margin="0,0,0,6"
                            Checked="OnLayerToggled" Unchecked="OnLayerToggled">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconRegion}" Style="{StaticResource ButtonIcon}" />
                  <TextBlock Text="พื้นที่การแปล" />
                </StackPanel>
              </ToggleButton>
            </WrapPanel>

            <TextBlock Text="โหมดเมาส์" Style="{StaticResource CardHeading}" />

            <WrapPanel>
              <RadioButton x:Name="ClickThroughOption" GroupName="MouseMode" IsChecked="True"
                           Checked="OnMouseModeChanged" Margin="0,0,20,6" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconPointer}" Style="{StaticResource ButtonIconFilled}" />
                  <TextBlock Text="คลิกทะลุ" />
                </StackPanel>
              </RadioButton>

              <RadioButton x:Name="InteractiveOption" GroupName="MouseMode"
                           Checked="OnMouseModeChanged" Margin="0,0,20,6" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconPointer}" Style="{StaticResource ButtonIconFilled}" />
                  <TextBlock Text="โต้ตอบได้" />
                </StackPanel>
              </RadioButton>

              <Button x:Name="ResetPanelButton" Click="OnResetPanelClick"
                      Padding="11,5" MinWidth="0" Margin="0,0,0,6"
                      ToolTip="ย้ายกรอบข้อความแปลกลับไปตำแหน่งเริ่มต้น">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconReset}" Style="{StaticResource ButtonIcon}" />
                  <TextBlock Text="รีเซ็ตตำแหน่งกรอบ" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <TextBlock x:Name="MouseModeHint"
                       Foreground="{StaticResource PanelMuted}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,8,0,14" />

            <TextBlock Text="โหมดการแปล" Style="{StaticResource CardHeading}" />

            <WrapPanel>
              <ToggleButton x:Name="AutoTranslateToggle" IsChecked="True" Padding="12,6" MinWidth="0"
                            Margin="0,0,10,6" Checked="OnAutoTranslateChanged" Unchecked="OnAutoTranslateChanged">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconRefresh}" Style="{StaticResource ButtonIcon}" />
                  <TextBlock Text="แปลอัตโนมัติ" />
                </StackPanel>
              </ToggleButton>

              <Button x:Name="TranslateOnceButton" Click="OnTranslateOnceClick" Padding="12,6" MinWidth="0"
                      Margin="0,0,0,6" IsEnabled="False" ToolTip="แปลสิ่งที่อยู่บนจอตอนนี้หนึ่งครั้ง">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource IconOnce}" Style="{StaticResource ButtonIconFilled}" />
                  <TextBlock Text="แปลครั้งเดียว" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <TextBlock x:Name="TranslateModeHint"
                       Foreground="{StaticResource PanelMuted}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="คีย์ลัด (ใช้ได้ตลอด แม้ขณะเล่นเกมอยู่ · เปลี่ยนได้ที่ปุ่มตั้งค่า)"
                       Style="{StaticResource CardHeading}" />
            <!-- Filled in code from the same list the keys are registered from. -->
            <UniformGrid x:Name="HotKeyGrid" Columns="2" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!--
      The four buttons fit on one line, and the window's minimum width is set to
      keep them there: dropping "เริ่มแปล" onto a second row on its own looked
      like a mistake rather than a layout.
    -->
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Click="OnSettingsClick" Margin="0,0,10,6">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconSettings}" Style="{StaticResource ButtonIcon}" />
          <TextBlock Text="ตั้งค่า" />
        </StackPanel>
      </Button>

      <Button Click="OnSetupClick" Margin="0,0,10,6">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconModel}" Style="{StaticResource ButtonIcon}" />
          <TextBlock Text="ตั้งค่าโมเดล" />
        </StackPanel>
      </Button>

      <Button Click="OnRefreshClick" Margin="0,0,10,6">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconRefresh}" Style="{StaticResource ButtonIcon}" />
          <TextBlock Text="รีเฟรช" />
        </StackPanel>
      </Button>

      <Button x:Name="EditRegionButton" Click="OnEditRegionClick" Margin="0,0,10,6" IsEnabled="False">
        <StackPanel Orientation="Horizontal">
          <Path Data="{StaticResource IconRegion}" Style="{StaticResource ButtonIcon}" />
          <TextBlock Text="เลือกพื้นที่การแปล" />
        </StackPanel>
      </Button>

      <Button x:Name="StartButton" Click="OnStartStopClick" Margin="0,0,0,6" IsEnabled="False">
        <StackPanel Orientation="Horizontal">
          <Path x:Name="StartButtonIcon" Data="{StaticResource IconPlay}" Style="{StaticResource ButtonIconFilled}" />
          <TextBlock x:Name="StartButtonText" Text="เริ่มแปล" />
        </StackPanel>
      </Button>
    </WrapPanel>
  </Grid>
</Window>
