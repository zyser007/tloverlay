<Window x:Class="TLOverlay.App.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLOverlay"
        Height="620" Width="760"
        Background="{StaticResource PanelBackground}"
        FontFamily="{StaticResource ThaiUiFont}">

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="เลือกหน้าต่างเกม" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="เกมต้องรันแบบ Windowed Fullscreen (Borderless) — โหมด Exclusive Fullscreen จะจับภาพไม่ได้"
                 Foreground="{StaticResource PanelMuted}"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0" />
    </StackPanel>

    <ListBox Grid.Row="1"
             x:Name="WindowList"
             Background="{StaticResource SurfaceBackground}"
             Foreground="{StaticResource PanelForeground}"
             BorderBrush="{StaticResource SurfaceBorder}"
             SelectionChanged="OnWindowSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4,6">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Foreground="{StaticResource PanelMuted}" FontSize="12">
              <Run Text="{Binding ProcessName, Mode=OneWay}" />
              <Run Text=" — " />
              <Run Text="{Binding Width, Mode=OneWay}" />
              <Run Text="x" />
              <Run Text="{Binding Height, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Border Grid.Row="2"
            Margin="0,12,0,0"
            Padding="14,10"
            CornerRadius="6"
            Background="{StaticResource SurfaceBackground}"
            BorderBrush="{StaticResource SurfaceBorder}"
            BorderThickness="1">
      <StackPanel>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        <TextBlock x:Name="MetricsText"
                   Foreground="{StaticResource PanelMuted}"
                   FontSize="12"
                   Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="3"
               Margin="0,12,0,0"
               Foreground="{StaticResource PanelMuted}"
               FontSize="12"
               TextWrapping="Wrap"
               Text="คีย์ลัด: Ctrl+Alt+T เปิด/ปิดการแปล · Ctrl+Alt+R เลือกพื้นที่ · Ctrl+Alt+H ซ่อนข้อความแปล · Ctrl+Alt+G ซ่อนกรอบพื้นที่ · Ctrl+Alt+C สลับคลิกทะลุ" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
      <TextBlock Text="แสดงบนจอ:" VerticalAlignment="Center"
                 Foreground="{StaticResource PanelMuted}" FontSize="12.5" Margin="0,0,10,0" />
      <ToggleButton x:Name="ShowTranslationsToggle" Content="ข้อความแปล" IsChecked="True"
                    Padding="12,6" MinWidth="0" Margin="0,0,8,0"
                    FontFamily="{StaticResource ThaiUiFont}"
                    Checked="OnLayerToggled" Unchecked="OnLayerToggled" />
      <ToggleButton x:Name="ShowRegionsToggle" Content="กรอบพื้นที่"
                    Padding="12,6" MinWidth="0"
                    FontFamily="{StaticResource ThaiUiFont}"
                    Checked="OnLayerToggled" Unchecked="OnLayerToggled" />
    </StackPanel>

    <StackPanel Grid.Row="5"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <Button Content="ตั้งค่าโมเดล" Click="OnSetupClick" Margin="0,0,10,0" />
      <Button Content="รีเฟรช" Click="OnRefreshClick" Margin="0,0,10,0" />
      <Button x:Name="EditRegionButton" Content="เลือกพื้นที่" Click="OnEditRegionClick" Margin="0,0,10,0" IsEnabled="False" />
      <Button x:Name="StartButton" Content="เริ่มแปล" Click="OnStartStopClick" IsEnabled="False" />
    </StackPanel>
  </Grid>
</Window>
