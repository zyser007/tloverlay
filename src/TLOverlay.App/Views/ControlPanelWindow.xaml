<Window x:Class="TLOverlay.App.Views.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLOverlay"
        Height="520" Width="720"
        Background="{StaticResource PanelBackground}"
        FontFamily="{StaticResource ThaiUiFont}">

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="เลือกหน้าต่างเกม"
               FontSize="20"
               FontWeight="SemiBold"
               Margin="0,0,0,4" />

    <TextBlock Grid.Row="1"
               Text="เกมต้องรันแบบ Windowed Fullscreen (Borderless) — โหมด Exclusive Fullscreen จะจับภาพไม่ได้"
               Foreground="{StaticResource PanelMuted}"
               TextWrapping="Wrap"
               Margin="0,0,0,12" />

    <ListBox Grid.Row="2"
             x:Name="WindowList"
             Background="#FF23262E"
             Foreground="{StaticResource PanelForeground}"
             BorderBrush="#FF343842"
             SelectionChanged="OnWindowSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4,6">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Foreground="{StaticResource PanelMuted}" FontSize="12">
              <Run Text="{Binding ProcessName, Mode=OneWay}" />
              <Run Text=" — " />
              <Run Text="{Binding Width, Mode=OneWay}" />
              <Run Text="x" />
              <Run Text="{Binding Height, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="3"
               x:Name="StatusText"
               Margin="0,12,0,0"
               TextWrapping="Wrap"
               Foreground="{StaticResource PanelMuted}" />

    <StackPanel Grid.Row="4"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,14,0,0">
      <Button Content="รีเฟรชรายการ" Click="OnRefreshClick" Margin="0,0,10,0" />
      <Button Content="ปิด" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>
