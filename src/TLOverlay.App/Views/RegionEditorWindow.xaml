<Window x:Class="TLOverlay.App.Views.RegionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เลือกพื้นที่แปล"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Cursor="Cross">

  <Grid>
    <!-- Existing regions are drawn here; the drag rectangle lives on top. -->
    <Canvas x:Name="Surface"
            Background="Transparent"
            MouseLeftButtonDown="OnMouseDown"
            MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseUp"
            SizeChanged="OnSurfaceSizeChanged" />

    <Border VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,28,0,0"
            Padding="18,10"
            CornerRadius="8"
            Background="#EE14161B">
      <StackPanel>
        <TextBlock x:Name="Hint"
                   Foreground="White"
                   FontFamily="Leelawadee UI, Segoe UI"
                   FontSize="15"
                   HorizontalAlignment="Center"
                   Text="ลากเมาส์คลุมกล่องบทสนทนาเพื่อกำหนดพื้นที่การแปล" />
        <TextBlock x:Name="Summary"
                   Foreground="#FF9AA3B2"
                   FontFamily="Leelawadee UI, Segoe UI"
                   FontSize="12.5"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0"
                   Text="Enter = บันทึก · Esc = ยกเลิก" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
