<Window x:Class="TLOverlay.App.Views.RegionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เลือกพื้นที่แปล"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#66000000"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Cursor="Cross">

  <Grid>
    <Canvas x:Name="Surface"
            Background="Transparent"
            MouseLeftButtonDown="OnMouseDown"
            MouseMove="OnMouseMove"
            MouseLeftButtonUp="OnMouseUp">
      <Rectangle x:Name="Selection"
                 Stroke="#FF4C8DFF"
                 StrokeThickness="2"
                 Fill="#224C8DFF"
                 Visibility="Collapsed" />
    </Canvas>

    <Border VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,28,0,0"
            Padding="18,10"
            CornerRadius="8"
            Background="#EE14161B">
      <TextBlock x:Name="Hint"
                 Foreground="White"
                 FontFamily="Leelawadee UI, Segoe UI"
                 FontSize="15"
                 Text="ลากเมาส์คลุมกล่องบทสนทนา — Enter เพื่อบันทึก, Esc เพื่อยกเลิก" />
    </Border>
  </Grid>
</Window>
