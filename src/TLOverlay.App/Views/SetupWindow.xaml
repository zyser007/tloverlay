<Window x:Class="TLOverlay.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLOverlay — ตั้งค่าครั้งแรก"
        Icon="/Assets/tloverlay.ico"
        Height="740" Width="620"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBackground}"
        FontFamily="{StaticResource ThaiUiFont}">

  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="PathText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource PanelMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="SmallButton" TargetType="Button">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
  </Window.Resources>

  <!--
    The body scrolls and the buttons do not. Thai text at 125% or 150% display
    scaling is half again as tall as it is at 100%, and a window sized for 100%
    cut "เสร็จแล้ว" off the bottom - where a first-run screen can least afford
    to lose its only way forward.
  -->
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">
      <StackPanel>

        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="ตั้งค่าครั้งแรก" FontSize="19" FontWeight="SemiBold" />
          <TextBlock Text="โปรแกรมแปลภาษาในเครื่องคุณเอง จึงต้องมี 2 อย่างนี้ก่อน — ดาวน์โหลดครั้งเดียว หลังจากนั้นใช้งานได้แบบออฟไลน์ตลอด"
                     Foreground="{StaticResource PanelMuted}"
                     TextWrapping="Wrap"
                     Margin="0,4,0,0" />
        </StackPanel>

        <!--
          The engine, first: it decides whether any of the rows below matter. A
          machine that cannot hold a model is exactly the machine whose owner
          must not be walked through downloading one.
        -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="เครื่องมือแปล" FontWeight="SemiBold" Margin="0,0,0,8" />

            <RadioButton x:Name="LocalEngineOption" GroupName="Engine" IsChecked="True"
                         Checked="OnEngineChanged" Margin="0,0,0,6">
              <StackPanel>
                <TextBlock Text="โมเดลในเครื่อง (ออฟไลน์ 100%)" FontWeight="SemiBold" />
                <TextBlock Text="ฟรี ไม่ส่งข้อความออกนอกเครื่อง แต่ต้องมีแรมว่างราว 3 GB และแปลช้ากว่าบน CPU"
                           Foreground="{StaticResource PanelMuted}" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="GoogleEngineOption" GroupName="Engine"
                         Checked="OnEngineChanged" Margin="0,0,0,6">
              <StackPanel>
                <TextBlock Text="Google แปลภาษา" FontWeight="SemiBold" />
                <TextBlock Text="เร็วบนเครื่องสเปกต่ำ เพราะไม่ได้ประมวลผลที่เครื่องเรา — แต่ข้อความในเกมจะถูกส่งไปที่ Google"
                           Foreground="{StaticResource PanelMuted}" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>

            <StackPanel x:Name="GooglePanel" Visibility="Collapsed" Margin="24,2,0,8">
              <TextBlock Text="Cloud Translation API key (ไม่ใส่ก็ได้)"
                         Foreground="{StaticResource PanelMuted}" FontSize="11.5" Margin="0,0,0,4" />
              <PasswordBox x:Name="GoogleKeyBox" Padding="8,6" PasswordChanged="OnSecretChanged" />
              <TextBlock Text="ไม่ใส่คีย์ = ใช้บริการฟรี ไม่ต้องสมัครอะไร แต่เป็นช่องทางที่ไม่เป็นทางการ อาจถูกจำกัดจำนวนคำขอหรือปิดเมื่อไรก็ได้"
                         Foreground="{StaticResource PanelMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <RadioButton x:Name="OpenAiEngineOption" GroupName="Engine"
                         Checked="OnEngineChanged" Margin="0,0,0,6">
              <StackPanel>
                <TextBlock Text="OpenAI / ChatGPT (ใช้ API key)" FontWeight="SemiBold" />
                <TextBlock Text="ภาษาไทยเป็นธรรมชาติที่สุดในสามแบบ คิดเงินตามจำนวนที่แปล และข้อความในเกมจะถูกส่งออกนอกเครื่อง"
                           Foreground="{StaticResource PanelMuted}" FontSize="11.5" TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>

            <StackPanel x:Name="OpenAiPanel" Visibility="Collapsed" Margin="24,2,0,0">
              <TextBlock Text="API key" Foreground="{StaticResource PanelMuted}" FontSize="11.5" Margin="0,0,0,4" />
              <PasswordBox x:Name="OpenAiKeyBox" Padding="8,6" PasswordChanged="OnSecretChanged" />

              <TextBlock Text="โมเดล" Foreground="{StaticResource PanelMuted}" FontSize="11.5" Margin="0,8,0,4" />
              <TextBox x:Name="OpenAiModelBox" Padding="8,6" FontFamily="{StaticResource MonoFont}"
                       FontSize="11.5" TextChanged="OnSecretTextChanged" />

              <TextBlock Text="ปลายทาง (เปลี่ยนได้ถ้าใช้ OpenRouter, Groq หรือเซิร์ฟเวอร์ของตัวเอง)"
                         Foreground="{StaticResource PanelMuted}" FontSize="11.5" Margin="0,8,0,4" />
              <TextBox x:Name="OpenAiBaseUrlBox" Padding="8,6" FontFamily="{StaticResource MonoFont}"
                       FontSize="11.5" TextChanged="OnSecretTextChanged" />
            </StackPanel>

            <WrapPanel x:Name="CloudTestPanel" Visibility="Collapsed" Margin="0,10,0,0">
              <Button x:Name="TestCloudButton" Style="{StaticResource SmallButton}"
                      Content="ทดสอบการแปล" Click="OnTestCloudClick" Margin="0,0,10,0" />
              <TextBlock x:Name="CloudTestResult" VerticalAlignment="Center" TextWrapping="Wrap"
                         FontSize="11.5" Foreground="{StaticResource PanelMuted}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <StackPanel x:Name="LocalModelSection">
                <!-- Where the two big files go. First, because it decides where the rest lands. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Path Grid.Column="0" Data="{StaticResource IconFolder}" Style="{StaticResource ButtonIcon}"
                  Margin="0" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Margin="6,0,10,0">
              <TextBlock Text="ตำแหน่งติดตั้ง" FontWeight="SemiBold" />
              <TextBlock x:Name="InstallPathText" Style="{StaticResource PathText}" />
              <TextBlock x:Name="FreeSpaceText" Foreground="{StaticResource PanelMuted}" FontSize="11.5"
                         Margin="0,3,0,0" />
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource SmallButton}"
                    Content="เปลี่ยนตำแหน่ง…" Click="OnChangeInstallLocationClick" />
          </Grid>
        </Border>

        <!-- llama-server.exe -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ServerGlyph" Grid.Column="0" Text="✗" FontSize="15" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Margin="6,0,10,0">
              <TextBlock Text="เซิร์ฟเวอร์แปลภาษา" FontWeight="SemiBold" />
              <TextBlock x:Name="ServerPath" Style="{StaticResource PathText}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="ServerDownloadButton" Style="{StaticResource SmallButton}"
                      Content="ดาวน์โหลด" Click="OnDownloadServerClick" Margin="0,0,8,0" />
              <Button Style="{StaticResource SmallButton}" Content="เลือกไฟล์เอง…"
                      Click="OnBrowseServerClick" Margin="0,0,8,0" />
              <Button x:Name="ServerDeleteButton" Style="{StaticResource SmallButton}"
                      Content="ลบ" Click="OnDeleteServerClick"
                      ToolTip="ลบเซิร์ฟเวอร์ที่ติดตั้งไว้ เพื่อคืนพื้นที่" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- model -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ModelGlyph" Grid.Column="0" Text="✗" FontSize="15" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Margin="6,0,10,0">
              <TextBlock Text="โมเดลแปลภาษา" FontWeight="SemiBold" />
              <TextBlock x:Name="ModelPath" Style="{StaticResource PathText}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="ModelDownloadButton" Style="{StaticResource SmallButton}"
                      Content="ดาวน์โหลด" Click="OnDownloadModelClick" Margin="0,0,8,0" />
              <Button Style="{StaticResource SmallButton}" Content="เลือกไฟล์เอง…"
                      Click="OnBrowseModelClick" Margin="0,0,8,0" />
              <Button x:Name="ModelDeleteButton" Style="{StaticResource SmallButton}"
                      Content="ลบ" Click="OnDeleteModelClick"
                      ToolTip="ลบโมเดลที่ติดตั้งไว้ เพื่อคืนพื้นที่" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="โมเดล" Foreground="{StaticResource PanelMuted}" FontSize="12" Margin="0,0,0,5" />
          <ComboBox x:Name="ModelCombo" SelectionChanged="OnModelSelectionChanged" Padding="8,6" />
          <TextBox x:Name="CustomUrl" Visibility="Collapsed" Margin="0,8,0,0" Padding="8,6"
                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                   TextChanged="OnCustomUrlChanged"
                   ToolTip="วาง URL ของไฟล์ .gguf โดยตรง" />
          <TextBlock x:Name="LicenseText" Foreground="{StaticResource PanelMuted}" FontSize="11.5"
                     TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock x:Name="ModelRamText" Foreground="{StaticResource PanelMuted}" FontSize="11.5"
                     TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="รันโมเดลบน" Foreground="{StaticResource PanelMuted}" FontSize="12" Margin="0,0,0,5" />
          <UniformGrid Columns="2">
            <RadioButton x:Name="CpuOption" GroupName="Backend" IsChecked="True" Margin="0,0,6,0"
                         Foreground="{StaticResource PanelForeground}">
              <StackPanel>
                <TextBlock Text="CPU" FontWeight="SemiBold" />
                <TextBlock Text="ไม่แย่ VRAM กับเกม แปลช้ากว่า (~2–4 วิ)"
                           Foreground="{StaticResource PanelMuted}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="GpuOption" GroupName="Backend" Margin="6,0,0,0"
                         Foreground="{StaticResource PanelForeground}">
              <StackPanel>
                <TextBlock Text="GPU NVIDIA" FontWeight="SemiBold" />
                <TextBlock Text="เร็วกว่ามาก (~0.5 วิ) แต่กิน VRAM ~2.5 GB"
                           Foreground="{StaticResource PanelMuted}" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </RadioButton>
          </UniformGrid>
        </StackPanel>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,14">
          <ProgressBar x:Name="DownloadBar" Height="6" Minimum="0" Maximum="1"
                       Background="{StaticResource TrackBackground}" Foreground="{StaticResource AccentBrush}" BorderThickness="0" />
          <Grid Margin="0,7,0,0">
            <TextBlock x:Name="ProgressLeft" HorizontalAlignment="Left"
                       FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                       Foreground="{StaticResource PanelMuted}" />
            <TextBlock x:Name="ProgressRight" HorizontalAlignment="Right"
                       FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                       Foreground="{StaticResource PanelMuted}" />
          </Grid>
        </StackPanel>

        <Expander Header="ไม่มีเน็ตบนเครื่องนี้?"
                  Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="0,4,0,0">
          <StackPanel Margin="4,8,0,0">
            <TextBlock Foreground="{StaticResource PanelMuted}" FontSize="12" TextWrapping="Wrap"
                       Text="โหลดไฟล์จากเครื่องอื่นแล้วก๊อปมาใส่ USB ได้ แล้วกดปุ่ม “เลือกไฟล์เอง…” ด้านบน" />
            <TextBlock x:Name="LogHint" Foreground="{StaticResource PanelMuted}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBox x:Name="OfflineUrls" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap"
                     BorderThickness="1" BorderBrush="{StaticResource SurfaceBorder}"
                     Background="{StaticResource CodeBackground}" Foreground="{StaticResource PanelForeground}"
                     FontFamily="{StaticResource MonoFont}" FontSize="11" Padding="8"
                     MaxHeight="120" VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </Expander>

        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                 TextWrapping="Wrap" Foreground="{StaticResource PanelMuted}" FontSize="12" />
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
        <Button x:Name="CancelButton" Content="ยกเลิกการโหลด" Click="OnCancelDownloadClick"
                Visibility="Collapsed" Margin="0,0,10,0" />
        <Button x:Name="SkipButton" Content="ข้ามไปก่อน" Click="OnSkipClick" Margin="0,0,10,0" />
        <Button x:Name="DoneButton" Content="เสร็จแล้ว" Click="OnDoneClick" IsEnabled="False" />
      </WrapPanel>
    </Grid>
  </Grid>
</Window>
