<Project>

  <PropertyGroup>
    <!--
      WinRT APIs (Windows.Graphics.Capture, Windows.Media.Ocr) require a Windows
      platform TFM. 10.0.19041 is the first build that exposes the capture
      settings we depend on (IsCursorCaptureEnabled); IsBorderRequired arrives
      later and is probed at runtime via ApiInformation.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>TLOverlay</Product>
    <Company>TLOverlay</Company>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
